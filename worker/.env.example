# Non-secret deploy settings read by alchemy.run.ts. Copy to .env (gitignored).
# Never put tokens, secrets or access URLs in this file; see docs/deployment.md.
SIMPLEFIN_HOSTNAME=bridge-7f3a.example.com
SIMPLEFIN_ZONE=example.com
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Zero Trust → Access controls → Service credentials → Executor's token
EXECUTOR_SERVICE_TOKEN_ID=00000000-0000-0000-0000-000000000000
EXECUTOR_CLIENT_ID=0123456789abcdef0123456789abcdef.access
TIME_ZONE=America/New_York
AUTO_SYNC_HOURS=12
INITIAL_SYNC_DAYS=365
